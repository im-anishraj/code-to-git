{
  "manifest_version": 3,
  "name": "Leet to Git",
  "description": "Automatically sync your LeetCode solutions to GitHub with ease.",
  "homepage_url": "https://github.com/im-anishraj/leet-to-git",
  "version": "__LH_VERSION__",
  "author": "im-anishraj",
  "action": {
    "default_icon": "assets/icon.png",
    "default_popup": "popup.html",
    "default_title": "Leet to Git"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "permissions": ["unlimitedStorage", "storage", "webNavigation"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["scripts/authorize.js"]
    },
    {
      "matches": ["https://practice.geeksforgeeks.org/*"],
      "js": ["scripts/gfg.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "devkaisel_leethub_v2@leethub.com",
      "strict_min_version": "109.0"
    }
  }
}
